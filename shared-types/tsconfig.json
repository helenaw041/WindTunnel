{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
	"moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
	"composite": true,
	"types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
