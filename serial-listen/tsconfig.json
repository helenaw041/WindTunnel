{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
	"moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
	"types": ["node"],
	"baseUrl": ".",
	"paths": {
      "@shared/*": ["../shared-types/src/*"] // Set up alias
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"],
  "references": [
    { "path": "../shared-types" } // Link to the shared project
  ]
}
